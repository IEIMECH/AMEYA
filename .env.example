# ==============================================================================
# AMEYA '26 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# NOTE: Never commit .env.local or real secrets to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Supabase Production Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Universal Admin Portal Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_DISPLAY_NAME=Operations Secretariat
ADMIN_SESSION_SECRET=your_long_64_character_hex_session_secret_here

# Email Gateway — Google Workspace / SMTP (Primary)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="AMEYA '26 - IEI SAME" <your_email@gmail.com>

# Email Gateway — Resend (Fallback)
RESEND_API_KEY=re_your_resend_api_key_here
