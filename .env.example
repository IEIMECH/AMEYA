# ==============================================================================
# AMEYA '26 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# NOTE: Never commit .env.local or real secrets to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Supabase Production Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cryptographic Session Secret
ADMIN_SESSION_SECRET=your_long_64_character_hex_session_secret_here

# 4 Operations Console Accounts (Private — Configure in .env.local & Vercel Dashboard)
ADMIN_USER_1=admin
ADMIN_PASS_1=your_secure_password_1
ADMIN_NAME_1=Lead Administrator

ADMIN_USER_2=operations
ADMIN_PASS_2=your_secure_password_2
ADMIN_NAME_2=Operations Desk

ADMIN_USER_3=events
ADMIN_PASS_3=your_secure_password_3
ADMIN_NAME_3=Events Secretariat

ADMIN_USER_4=hospitality
ADMIN_PASS_4=your_secure_password_4
ADMIN_NAME_4=Gate & Hospitality

# Email Gateway — Google Workspace / SMTP (Primary)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="AMEYA '26 - IEI SAME" <your_email@gmail.com>

# Email Gateway — Resend (Fallback)
RESEND_API_KEY=re_your_resend_api_key_here
