# ==============================================================================
# AMEYA '26 Production Environment Configuration
# Target Domain: https://ieisame.vvitu.ac.in
# ==============================================================================

# Base URL for QR code, ticket verification & dynamic links
NEXT_PUBLIC_BASE_URL=https://ieisame.vvitu.ac.in

# Supabase Database & Auth (Project Credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Workspace / Gmail SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="AMEYA '26" <your-email@gmail.com>

# Admin Session JWT / HMAC Secret (Generate 32+ random characters)
ADMIN_SESSION_SECRET=your-secure-random-session-secret-here

# ------------------------------------------------------------------------------
# 5 Role-Based Admin Logins (Portals: /admin/login)
# ------------------------------------------------------------------------------
ADMIN_USER_1=president
ADMIN_PASS_1=your-secure-password-1
ADMIN_NAME_1="President"

ADMIN_USER_2=vicepresident
ADMIN_PASS_2=your-secure-password-2
ADMIN_NAME_2="Vice President"

ADMIN_USER_3=secretary
ADMIN_PASS_3=your-secure-password-3
ADMIN_NAME_3="Secretary"

ADMIN_USER_4=eventshead
ADMIN_PASS_4=your-secure-password-4
ADMIN_NAME_4="Events Head"

ADMIN_USER_5=technicals
ADMIN_PASS_5=your-secure-password-5
ADMIN_NAME_5="Technicals Lead"
